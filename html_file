',874454,1206,994,97,1,1.8],['PQ FI','PQ','#3aa898','#fff',579425,36960,20355,998,9,2.9],['KYC','PQ','#6cc2b5','#1b2433',442374,13527,7125,310,23,2.1],['NACH','PQ','#9fd8cf','#1b2433',138979,4209,2557,179,12,2.4],['NACH+KYC','PQ','#c7e9e3','#1b2433',57589,394,246,12,1,2.0],\n      ['TopUp PA','TU','#b4541f','#fff',98952,12312,6681,937,78,1.6],['TopUp NACH+KYC','TU','#e07b39','#fff',14032,190,145,32,1,1.1],['TopUp NACH','TU','#efa673','#1b2433',11901,425,305,59,7,1.3],['TopUp KYC','TU','#f6cba8','#1b2433',4285,504,292,48,3,1.2],['Other','OT','#98a2b3','#1b2433',-54,-9,0,-1,15,2.0]];\n    const P = raw.map(([name,g,c,tx,offer,login,impr,click,cnt,t])=>({name,g,c,tx,offer,login,impr,click,cnt,amt:cnt*t/100}));\n    const V = (p,id) => Math.max(0,p[id]);\n    const sum = (arr,id) => arr.reduce((s,p)=>s+V(p,id),0);\n    G.forEach(g=>{g.P=P.filter(p=>p.g===g.id);M.forEach(m=>g[m.id]=sum(g.P,m.id));});\n    const lab = id => M.find(m=>m.id===id).label;\n    const conv = (cnt,login) => login>0 ? this.fP(cnt/login*100) : '—';\n    const seg = (key,cur) => M.map(m=>({label:m.label.replace('Core DB ','Core '),onClick:()=>this.setState({[key]:m.id}),bg:m.id===cur?'#1b2433':'transparent',fg:m.id===cur?'#fff':'#475467'}));\n    const ring = (items,id,r,gap) => {const T=items.reduce((s,x)=>s+x.v,0)||1, C=2*Math.PI*r; let st=0;\n      return items.map(x=>{const len=x.v/T*C, g=len>gap*2?gap:0; const o={...x,share:this.fP(x.v/T*100),value:this.fmt(id,x.v),dash:Math.max(0,len-g).toFixed(2)+' '+(C-len+g).toFixed(2),off:(-st).toFixed(2),\n        op:hv&&hv!==x.name&&hv!==x.g?.25:1,enter:()=>this.setState({hv:x.name}),leave:()=>this.setState({hv:null})};st+=len;return o;});};\n    const gItems = id => G.map(g=>({name:g.name,g:g.name,c:g.c,v:g[id]}));\n    const pItems = id => G.flatMap(g=>g.P.map(p=>({name:p.name,g:g.name,c:p.c,v:V(p,id)})).sort((x,y)=>y.v-x.v));\n    const groupCards = id => {const T=sum(P,id)||1; return G.map(g=>{const mx=Math.max(...g.P.map(p=>V(p,id)))||1;\n      return {name:g.name,c:g.c,tint:g.tint,metric:lab(id),value:this.fmt(id,g[id]),share:this.fP(g[id]/T*100),conv:conv(g.cnt,g.login),\n        progs:g.P.slice().sort((x,y)=>V(y,id)-V(x,id)).map(p=>({name:p.name,c:p.c,value:this.fmt(id,V(p,id)),share:this.fP(V(p,id)/T*100),w:Math.max(1,V(p,id)/mx*100).toFixed(1)+'%'}))};});};\n    // 2a\n    const ringGD = ring(gItems(d),d,54,1), ringPD = ring(pItems(d),d,84,1);\n    const PC = {'PA':'#3d6bb3','PA NTC':'#4a9fd6','Standalone asset':'#13897a','Dormant':'#8a5a2b','PQ FI':'#7b5cc4','KYC':'#1d2b4f','NACH':'#d4a02a','NACH+KYC':'#c2477a','PQ common':'#5b8c3a','Other':'#98a2b3','TopUp PA':'#e07b39','TopUp NACH+KYC':'#e35d6a','TopUp NACH':'#5aa3a8','TopUp KYC':'#b07aa1'};\n    const ringD = ring(pItems(d).map(x=>({...x,c:PC[x.name]})),d,78,1);\n    const TD = sum(P,d)||1;\n    const FT = {'PA':3951,'PA NTC':64,'Standalone asset':1212,'Dormant':85,'PQ FI':860,'KYC':281,'NACH':163,'NACH+KYC':10,'PQ common':1,'Other':-1,'TopUp PA':868,'TopUp NACH+KYC':27,'TopUp NACH':50,'TopUp KYC':43};\n    P.forEach(p=>p.foot=FT[p.name]); G.forEach(g=>g.foot=sum(g.P,'foot'));\n    const sel = this.state.sel || 'all';\n    const ent = {all:{name:'Overall PL',login:tot.login,impr:tot.impr,click:tot.click,foot:P.reduce((s,p)=>s+p.foot,0),cnt:tot.cnt}};\n    G.forEach(g=>ent['g:'+g.id]={...g,name:g.name+' (all)'}); P.forEach(p=>ent['p:'+p.name]=p);\n    const pick = k => ({onClick:()=>this.setState({sel:k}),sh:sel===k?'inset 0 0 0 2px #1b2433':'none'});\n    const cellsOf = o => [this.fmt('login',o.login),this.fmt('impr',o.impr),this.fmt('click',o.click),this.fmt('click',o.foot),this.fmt('amt',o.amt)];\n    const groupsD = G.map(g=>({name:g.name,c:g.c,tint:g.tint,count:g.id==='OT'?'':g.P.length+' programs',n:g.id==='OT'?1:g.P.length+1,cells:cellsOf(g),...pick('g:'+g.id),\n      op:hv&&hv!==g.name&&!g.P.some(p=>p.name===hv)?.4:1,enter:()=>this.setState({hv:g.name}),leave:()=>this.setState({hv:null}),\n      progs:(g.id==='OT'?[]:g.P).slice().sort((x,y)=>V(y,d)-V(x,d)).map(p=>({name:p.name,c:PC[p.name],cells:cellsOf({...p,login:V(p,'login'),click:V(p,'click'),foot:V(p,'foot')}),...pick('p:'+p.name),\n        op:hv&&hv!==p.name&&hv!==g.name?.4:1,bg:hv===p.name?'#f5f6f8':'transparent',enter:()=>this.setState({hv:p.name}),leave:()=>this.setState({hv:null})}))}));\n    const E = ent[sel] || ent.all;\n    const rt = (n,dn,l,c) => {const v=dn>0?Math.max(0,n)/dn*100:0;return {label:l,c,value:dn>0?this.fP(v):'—',w:Math.min(100,v).toFixed(1)+'%',frac:this.fmt('click',Math.max(0,n))+' of '+this.fmt('click',Math.max(0,dn))};};\n    const convD = [rt(E.impr,E.login,'Login → Impression','#7b5cc4'),rt(E.click,E.impr,'Impression → Click','#e07b39'),rt(E.foot,E.click,'Click → Footprint','#8a5a2b'),rt(E.cnt,E.login,'Login → Disbursal','#13897a')];\n    const selOpts = [{id:'all',label:'Overall PL'}].concat(G.filter(g=>g.id!=='OT').map(g=>({id:'g:'+g.id,label:g.name+' (all)'})),P.map(p=>({id:'p:'+p.name,label:'  '+p.name}))).map(o=>({...o,sel:o.id===sel}));\n    const ringDG = ringD.map(x=>({...x,op:hv&&hv!==x.name&&hv!==x.g?.25:1}));\n    const hit = hv && (ringD.find(x=>x.name===hv) || ringGD.find(x=>x.name===hv));\n    // 2b\n    const stackE = M.map(m=>{const T=sum(P,m.id)||1, on=m.id===e;\n      const items = lvl==='p' ? pItems(m.id) : gItems(m.id).map((x,i)=>({...x,tx:'#fff'}));\n      return {label:m.label,total:this.fmt(m.id,tot[m.id]),onClick:()=>this.setState({e:m.id}),bg:on?'#f5f6f8':'transparent',sh:on?'inset 3px 0 0 #1b2433':'none',\n        segs:items.filter(x=>x.v>0).map(x=>{const s=x.v/T*100;const pp=P.find(p=>p.name===x.name);return {c:x.c,tx:pp?pp.tx:'#fff',w:'calc('+s.toFixed(3)+'% - 2px)',lbl:s>=(lvl==='p'?9:5)?(lvl==='p'?x.name+' ':'')+this.fP(s):'',tip:x.name+': '+this.fP(s)};})};});\n    // 2c\n    const TF = sum(P,f)||1;\n    const tmF = G.map(g=>{const its=g.P.map(p=>({...p,v:V(p,f)})).filter(p=>p.v>0).sort((x,y)=>y.v-x.v);const gt=g[f]||1;\n      const big=its.filter(p=>p.v/gt>=.06), small=its.filter(p=>p.v/gt<.06);\n      const items=big.map(p=>({name:p.name,c:p.c,tx:p.tx,grow:(p.v/gt*1000).toFixed(0),share:this.fP(p.v/TF*100),value:this.fmt(f,p.v),tip:p.name}));\n      if(small.length){const sv=small.reduce((s,p)=>s+p.v,0);items.push({name:'+'+small.length+' smaller',c:'#e6e8ec',tx:'#475467',grow:Math.max(60,sv/gt*1000).toFixed(0),share:this.fP(sv/TF*100),value:this.fmt(f,sv),tip:small.map(p=>p.name).join(', ')});}\n      return {name:g.name,c:g.c,grow:Math.max(1,g[f]/TF*1000).toFixed(0),share:this.fP(g[f]/TF*100),items};});\n    const mf = M.find(m=>m.id===f);\n    const headF = [{t:'Program',al:'left',fg:'#98a2b3'}].concat(M.map(m=>({t:m.label.replace('Core DB ','Core '),al:'right',fg:m.id===f?m.c:'#98a2b3'})),[{t:'Share',al:'right',fg:mf.c}]);\n    const trow = (name,c,o,kind) => ({name,c,bg:kind==='all'?'#eef0f3':kind==='g'?'#f7f8fa':'transparent',fw:kind==='p'?500:800,ind:kind==='p'?'18px':'0',\n      cells:M.map(m=>({v:this.fmt(m.id,o[m.id]),fw:kind!=='p'||m.id===f?800:400,fg:m.id===f?mf.c:'#1b2433'})).concat([{v:this.fP(Math.max(0,o[f])/TF*100),fw:800,fg:mf.c}])});\n    const tblF = [trow('Overall PL','#1b2433',tot,'all')].concat(G.flatMap(g=>[trow(g.name,g.c,g,'g')].concat(g.P.map(p=>trow(p.name,p.c,p,'p')))));\n    const pc = (n,dn) => this.fP(n/dn*100);\n    const tint = {'#667085':'#f0f1f4','#3d6bb3':'#ecf1f9','#7b5cc4':'#f1edf9','#e07b39':'#fcf0e7','#13897a':'#e7f3f1','#1d2b4f':'#e9ebf1'};\n    const subs = {offer:'14 programs',login:pc(tot.login,tot.offer)+' of offer base',impr:pc(tot.impr,tot.login)+' of logins',click:pc(tot.click,tot.impr)+' of impressions',cnt:pc(tot.cnt,tot.login)+' of logins',amt:'₹'+(tot.amt*100/tot.cnt).toFixed(2)+' L per loan'};\n    const kpisD = M.map(m=>({label:m.label,c:m.c,tint:tint[m.c],value:this.fmt(m.id,tot[m.id]),sub:subs[m.id]}));\n    const calOpen = !!this.state.cal;\n    const calDays = Array.from({length:3},()=>({d:'',bg:'transparent',fg:'#1b2433',fw:400,cur:'default'})).concat(Array.from({length:31},(_,i)=>{const dd=i+1,on=dd===14,fut=dd>19;\n      return {d:dd,bg:on?'#1b2433':'transparent',fg:on?'#fff':fut?'#d0d5dd':'#98a2b3',fw:on?800:500,cur:on?'pointer':'default',onClick:on?()=>this.setState({cal:false}):undefined};}));\n    return { kpisD, calOpen, calDays, calHead:['M','T','W','T','F','S','S'], calBd:calOpen?'#1b2433':'#d0d5dd', toggleCal:()=>this.setState(s=>({cal:!s.cal})), segD:seg('d',d), ringGD, ringPD, ringD:ringDG, groupsD, metricD:lab(d), convD, selOpts, onSel:ev=>this.setState({sel:ev.target.value}),\n      cNameD: hit?hit.name:lab(d), cShareD: hit?hit.share:this.fmt(d,tot[d]), cValD: hit?hit.value:'Overall PL',\n      legD: ringGD.map(g=>({name:g.name,c:g.c,share:g.share,value:g.value})), gD:groupCards(d),\n      grpKey:G, lvlE:[['g','Groups'],['p','Programs']].map(([id,label])=>({label,onClick:()=>this.setState({lvl:id}),bg:lvl===id?'#1b2433':'transparent',fg:lvl===id?'#fff':'#475467'})),\n      stackE, gE:groupCards(e),\n      tilesF: M.map(m=>{const on=m.id===f;return {label:m.label,c:m.c,value:this.fmt(m.id,tot[m.id]),onClick:()=>this.setState({f:m.id}),bd:on?'#1b2433':'#e6e8ec',sh:on?'0 0 0 1px #1b2433':'none',cue:on?'#1b2433':'transparent',hint:'Showing share'};}),\n      labelF: lab(f), tmF, headF, tblF };\n  }\n  renderVals() {\n    const { a, b, c } = this.state;\n    const { P, M, tot } = this.data();\n    const lab = id => M.find(m=>m.id===id).label;\n    const conv = p => p.login > 0 ? this.fP(p.cnt/p.login*100) : '—';\n    const kpis = M.map(m=>({label:m.label,c:m.c,value:this.fmt(m.id,tot[m.id])}));\n    const segA = M.map(m=>({label:m.label.replace('Core DB ','Core '),onClick:()=>this.setState({a:m.id}),bg:m.id===a?'#1b2433':'transparent',fg:m.id===a?'#fff':'#475467'}));\n    const ma = M.find(m=>m.id===a);\n    const headA = [{t:'Program',al:'left',fg:'#98a2b3'}].concat(M.map(m=>({t:m.label.replace('Core DB ','Core '),al:'right',fg:m.id===a?m.c:'#98a2b3'})),[{t:'Login→Core',al:'right',fg:'#98a2b3'}]);\n    const row = (p,isAll) => ({name:p.name,c:p.c,fw:isAll?800:600,bg:isAll?'#f5f6f8':'transparent',\n      cells:M.map(m=>({v:this.fmt(m.id,p[m.id]),fw:m.id===a||isAll?800:400,fg:m.id===a?ma.c:'#1b2433'})).concat([{v:conv(p),fw:isAll?800:400,fg:'#667085'}])});\n    const rowsA = [row({name:'Overall PL',c:'#1b2433',...tot},true)].concat(P.map(p=>row(p,false)));\n    const tilesB = M.map(m=>{const on=m.id===b;return {label:m.label,c:m.c,value:this.fmt(m.id,tot[m.id]),onClick:()=>this.setState({b:m.id}),bg:on?'#fff':'rgba(255,255,255,.07)',fg:on?'#1b2433':'#fff',sub:on?'#667085':'#aab4c8'};});\n    const pieB = this.pie(P,b,74,1.2);\n    const sortedB = P.map(p=>({...p,v:Math.max(0,p[b])})).sort((x,y)=>y.v-x.v);\n    const TB = sortedB.reduce((s,x)=>s+x.v,0), mxB = sortedB[0].v||1;\n    const barsB = sortedB.map(p=>({name:p.name,c:p.c,w:Math.max(.5,p.v/mxB*100).toFixed(1)+'%',value:this.fmt(b,p.v),share:this.fP(p.v/TB*100),conv:conv(p)}));\n    const listC = M.map(m=>({label:m.label,c:m.c,value:this.fmt(m.id,tot[m.id]),sub:m.id===c?'#fff':'#aab4c8',fs:m.id===c?'20px':'15px'}));\n    const pieC = this.pie(P,c,45,0);\n    const sortedC = P.map(p=>({...p,v:Math.max(0,p[c])})).sort((x,y)=>y.v-x.v);\n    const TC = sortedC.reduce((s,x)=>s+x.v,0), mxC = sortedC[0].v||1;\n    const tilesC = sortedC.map(p=>({name:p.name,c:p.c,value:this.fmt(c,p.v),share:this.fP(p.v/TC*100),w:Math.max(1,p.v/mxC*100).toFixed(1)+'%',\n      minis:[{l:'Offer base',v:this.fmt('offer',p.offer)},{l:'Logins',v:this.fmt('login',p.login)},{l:'Login→Core',v:conv(p)}]}));\n    return { ...this.r2(M, tot), kpis, segA, pieA:this.pie(P,a,78,1.2), labelA:lab(a), totA:this.fmt(a,tot[a]), headA, rowsA,\n      tilesB, pieB, labelB:lab(b), topB:pieB[0].name, topBShare:pieB[0].share, barsB,\n      c, optsC:M.map(m=>({id:m.id,label:m.label,sel:m.id===c})), onC:e=>this.setState({c:e.target.value}), listC, pieC, labelC:lab(c), tilesC };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
