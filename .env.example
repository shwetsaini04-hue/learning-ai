# ─────────────────────────────────────────────────────────────────────────────
# AI Engineering Lab — server-side environment variables
# Copy to .env.local for local development. NEVER commit real keys.
# On Vercel: Project → Settings → Environment Variables.
#
# All variables are optional. With none set, the lab runs fully in
# Simulation mode (free, deterministic, no API calls).
# ─────────────────────────────────────────────────────────────────────────────

# --- Model providers (enable "Live mode" in the app's Settings page) --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (Groq, Together, OpenRouter, local Ollama, …)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODELS=llama3.1:8b,qwen2.5:7b

# --- Safety & cost guards -----------------------------------------------------
# Set to "false" to hard-disable live calls even if keys are present.
LIVE_LLM_ENABLED=true

# If set, browsers must send this token (entered in Settings) to use live calls.
# Strongly recommended for any public deployment that has API keys configured.
LAB_ACCESS_TOKEN=

# Per-request limits enforced by /api/llm
MAX_INPUT_CHARS=16000
MAX_OUTPUT_TOKENS=1024

# Best-effort, per server instance (use a shared store for hard quotas)
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_LIMIT=500
